<mxfile><diagram name="architecture"><mxGraphModel dx="2000" dy="1120" grid="0" page="1" pageWidth="2000" pageHeight="1120" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="Strands Decider 2B on Amazon EKS Auto Mode (Graviton, CPU only)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=34;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="50" as="geometry"/></mxCell><mxCell id="c12" value="Solid lines: runtime path. Dashed: one-time build path and optional parts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=19;fontColor=#4A4A4A;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1900" height="40" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Build once, same account: bootstrap stack&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=52;spacingTop=6;fontFamily=Helvetica;fontSize=22;fontColor=#232F3E;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="560" height="950" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Hugging Face Hub&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4A4A4A&#x27;&gt;model + base model&lt;/font&gt;" style="shape=image;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="90" y="270" width="90" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;AWS CodeBuild&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4A4A4A&#x27;&gt;arm64&lt;/font&gt;" style="shape=image;verticalLabelPosition=top;verticalAlign=bottom;labelPosition=center;align=center;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="330" y="270" width="90" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Amazon ECR&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4A4A4A&#x27;&gt;server image&lt;/font&gt;" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="450" y="430" width="90" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4A4A4A&#x27;&gt;model/ 4.8 GB&lt;/font&gt;" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="450" y="640" width="90" height="90" as="geometry"/></mxCell><mxCell id="c18" value="download" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2.5;dashed=1;fontFamily=Helvetica;fontSize=17;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="build, push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2.5;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=17;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="stage weights" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2.5;dashed=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=17;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="Nothing runs on your laptop. The image holds only the server; the weights stay in S3 and each pod copies them into memory when it starts (about 4 s), so a new checkpoint needs no rebuild." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=19;fontColor=#4A4A4A;" vertex="1" parent="1"><mxGeometry x="70" y="850" width="510" height="220" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;AWS Cloud: your account, one Region&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=52;spacingTop=6;fontFamily=Helvetica;fontSize=22;fontColor=#232F3E;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=top;" vertex="1" parent="1"><mxGeometry x="640" y="130" width="1320" height="950" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;VPC: 2 AZs, private subnets, 1 NAT gateway, S3 gateway endpoint&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=52;spacingTop=6;fontFamily=Helvetica;fontSize=20;fontColor=#232F3E;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=top;" vertex="1" parent="1"><mxGeometry x="670" y="190" width="1260" height="870" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;EKS Auto Mode cluster: Auto Mode adds and removes nodes; the HPA adds pods&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fontSize=20;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="700" y="250" width="1200" height="640" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;&lt;/b&gt;" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#232F3E;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1826" y="258" width="60" height="60" as="geometry"/></mxCell><mxCell id="c26" value="NodePool decider-large: 1 x m9g.16xlarge (Graviton5, 64 vCPU)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fontSize=19;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="730" y="330" width="640" height="370" as="geometry"/></mxCell><mxCell id="c27" value="pod 1&lt;br&gt;bf16&lt;br&gt;16 threads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8E8;strokeColor=#7AA116;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="130" height="130" as="geometry"/></mxCell><mxCell id="c28" value="pod 2&lt;br&gt;bf16&lt;br&gt;16 threads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8E8;strokeColor=#7AA116;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="910" y="420" width="130" height="130" as="geometry"/></mxCell><mxCell id="c29" value="pod 3&lt;br&gt;bf16&lt;br&gt;16 threads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8E8;strokeColor=#7AA116;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1060" y="420" width="130" height="130" as="geometry"/></mxCell><mxCell id="c30" value="pod 4&lt;br&gt;bf16&lt;br&gt;16 threads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8E8;strokeColor=#7AA116;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1210" y="420" width="130" height="130" as="geometry"/></mxCell><mxCell id="c31" value="One request at a time per pod, so throughput comes from pods. About 0.46 s per decision." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontColor=#4A4A4A;" vertex="1" parent="1"><mxGeometry x="760" y="580" width="590" height="100" as="geometry"/></mxCell><mxCell id="c32" value="NodePool decider-small: m9g.4xlarge, one pod per node (optional layout)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fontSize=19;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1400" y="330" width="470" height="370" as="geometry"/></mxCell><mxCell id="c33" value="pod&lt;br&gt;bf16&lt;br&gt;16 threads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8E8;strokeColor=#7AA116;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1440" y="440" width="170" height="130" as="geometry"/></mxCell><mxCell id="c34" value="more pods&lt;br&gt;(HPA)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7AA116;strokeWidth=2;dashed=1;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1650" y="440" width="170" height="130" as="geometry"/></mxCell><mxCell id="c35" value="Service decider&lt;br&gt;ClusterIP :8080&lt;br&gt;/invocations, /ping" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;verticalAlign=top;align=center;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="760" y="740" width="300" height="120" as="geometry"/></mxCell><mxCell id="c36" val