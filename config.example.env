# Copy to config.env and edit. Everything account-specific lives here; quickstart.sh reads it.

# Name prefix for every resource (S3 bucket, ECR repo, CodeBuild project, EKS cluster, IAM roles).
NAME=strands-decider
REGION=eu-west-1
# AWS CLI profile to use (leave empty to use the default credential chain).
PROFILE=

# Kubernetes version for the EKS cluster.
K8S_VERSION=1.36

# Who may reach the EKS API endpoint. "auto" = this machine's current public IP (/32).
# Use a list such as "203.0.113.0/24,198.51.100.7/32" for a team.
API_CIDRS=auto

# The model: a 2B strands-decider checkpoint on the Hugging Face Hub, and its base model, each pinned to a fixed
# commit so every build downloads the same weights (the revisions tested for this sample). If you change MODEL_ID,
# set MODEL_REVISION to that model's commit hash; empty = the repo's main branch at build time (not recommended).
# The measured results in README.md are for qwen3.5-v1-2610 (strands-decider's default model) with 0.2.0.
MODEL_ID=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
MODEL_REVISION=216d1ccb46a9e9b036eb9187b248db98480f77d4  # pragma: allowlist secret (a public Hugging Face commit hash, not a secret)
BASE_MODEL_ID=Qwen/Qwen3.5-2B-Base
# If you change BASE_MODEL_ID, change this too; empty = the base revision the checkpoint records.
BASE_MODEL_REVISION=b1485b2fa6dfa1287294f269f5fb618e03d52d7c  # pragma: allowlist secret (a public Hugging Face commit hash)
# strands-decider package version in the image (match what your checkpoint was trained with).
DECIDER_VERSION=0.2.0

# The example triage agent (./quickstart.sh agent): messages whose route confidence is below CONFIDENCE_THRESHOLD
# escalate to this foundation model on Amazon Bedrock (an inference profile ID; use the us. or apac. prefix
# outside Europe). Choose the threshold with ./quickstart.sh threshold.
ESCALATION_MODEL_ID=eu.amazon.nova-2-lite-v1:0
CONFIDENCE_THRESHOLD=0.7

# Who may connect to the internal NLB (./quickstart.sh expose), comma-separated. Empty = the cluster's VPC only;
# add a peered VPC's or on-premises CIDR here.
NLB_CIDRS=

# Graviton (arm64) instance types for the NodePools. Measured on Graviton5 (m9g). If your Region lacks m9g,
# try m8g or c8g of the same size. Re-check bf16 vs fp32 if you change generation (see README).
INSTANCE_LARGE=m9g.16xlarge
INSTANCE_SMALL=m9g.4xlarge
INSTANCE_BENCH=c8g.xlarge
# Cost guard: at most this many nodes per Decider NodePool.
MAX_NODES=4

# Default layout for ./quickstart.sh deploy: <pool>-<pods>x<threads>-<dtype>, pool = large or small.
VARIANT=small-1x16-bf16
